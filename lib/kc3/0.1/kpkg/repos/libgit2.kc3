require Kpkg.Package

defmodule Kpkg.Repos.LibGit2 do

  Kpkg.defpackage(
    %Kpkg.Package{name: :libgit2,
                  build_depends_on: [:libiconv],
                  default_branch: "main",
                  depends_on: [],
                  dir: "libgit2/libgit2",
                  git: "https://git.kmx.io/kc3-lang/libgit2.git",
                  git_push: "git@git.kmx.io:kc3-lang/libgit2.git",
                  module: module()}
  )

end
