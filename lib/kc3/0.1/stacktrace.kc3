defmodule Stacktrace do

  def ptr = cfn Ptr "kc3_stacktrace_ptr" (Result)

  def to_str = cfn Str "kc3_stacktrace_to_str" (Ptr, Result)

  def to_str_short = cfn Str "kc3_stacktrace_to_str_short" (Ptr, Result)

end
