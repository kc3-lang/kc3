defmodule SHA512 do

  def hmac = cfn Str "sha512_hmac_str" (Str, Str, Result)

  def hmac_str = fn (msg) {
    "#{Base64.encode(SHA512.hmac(msg, Config.secret))} #{msg}"
  }

  def hmac_str_verify = fn (str) {
    hmac = Str.slice(str, 0, 88)
    msg = Str.slice(str, 89, -1)
    if Base64.encode(SHA512.hmac(msg, Config.secret)) == hmac do
      msg
    end
  }

end
