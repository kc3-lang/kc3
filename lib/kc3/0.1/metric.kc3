require URL

defmodule Metric do

  def normalize = fn (key) {
    key = URL.unescape(key)
    if (key != "/" && Str.ends_with?(key, "/")) do
      Str.slice(key, 0, -2)
    else
      key
    end
  }

  def get = fn (key) {
    key = normalize(key)
    Metric.get_normalized(key)
  }

  def get_normalized = fn (key) {
    count = Facts.first_with_tags(Config.db, key, :metric_hits, count = ?,
      fn (x) { count })
    if is_integer?(count) do
      count
    else
      0
    end
  }

  def hit = fn (key) {
    key = normalize(key)
    Facts.with_transaction(Config.db, do
      count = Metric.get_normalized(key) + 1
      Facts.replace_tags(Config.db, key, :metric_hits, count)
      count
    end)
  }

end
