require Buf
require Counter
require Daemon
require Facts
require File
require HTML
require HTTP
require HTTP.Request
require HTTP.Response
require HTTPd.Route
require EventPoll
require Socket
require Socket.Buf
require Stacktrace
require Str
require Thread
require URL

defmodule HTTPd do

  def acceptor_tag = Tag.new_copy(:acceptor)

  def bots = Counter.new(0)

  def bots_max = fn () { (ncpu() / 4) || 1 }

  def concurrent_requests = Counter.new(0)

  def connections = Counter.new(0)

  def connections_max = fn () {
    HTTPd.thread_max() * 2
  }

  def ep_fd = ?

  def requests = Counter.new(0)

  def socket = ?

  def stop_tag = Tag.new_copy(:stop)

  def thread_count = Counter.new(0)

  def thread_max = fn () { ncpu() * 2 }

  def timeout = %Time{tv_sec: 30}

  def load_app = fn () {
    HTTP.mime_type_load("config/mime.types")
    load_directory!("app/lib/")
    load_directory!("app/models/")
    if (File.exists?("config/app.kc3")) do
      load!("config/app.kc3")
    end
    if (File.exists?("config/at_exit.kc3")) do
      load!("config/at_exit.kc3")
    end
    if (File.exists?("config/db.kc3")) do
      load!("config/db.kc3")
    end
    if (File.exists?("config/secret.kc3")) do
      load!("config/secret.kc3")
    end
    load_directory!("app/views/")
    load_directory!("app/controllers/")
    if (File.exists?("config/routes.kc3")) do
      load!("config/routes.kc3")
    end
    load_directory!("app/plugs/")
    if (File.exists?("config/unveil.kc3")) do
      load!("config/unveil.kc3")
    end
    securelevel(2)
    IO.puts("HTTPd.load_app: done")
  }

  def thread_db = Facts.database()

  def thread_status = fn (thread_id, status) {
    Facts.replace_tags(HTTPd.thread_db, :thread_status, thread_id,
      %{id: thread_id,
        status: status,
        time: Time.now()})
  }

  def thread_request = fn (thread_id, msg) {
    IO.puts(msg)
    Err.puts(msg)
    Facts.replace_tags(HTTPd.thread_db, :thread_request, thread_id, msg)
  }

  def thread_stacktrace = fn (thread_id, ptr) {
    Facts.replace_tags(HTTPd.thread_db, :thread_stacktrace, thread_id, ptr)
  }

  def clean_upload = fn (file) {
    if (file != "." && file != "..") do
      path = HTTP.Upload.tmp_filename_prefix + file
      IO.puts("HTTPd.clean_all_uploads: RM #{inspect(path)}")
      File.unlink(path)
    end
  }

  def clean_all_uploads = fn () {
    if (File.exists?(HTTP.Upload.tmp_filename_prefix)) do
      List.each(File.list(HTTP.Upload.tmp_filename_prefix),
        HTTPd.clean_upload)
    end
  }

  def clean_request_uploads = fn (params) {
    if params do
      List.each(params, fn {
        ({key, value}) {
          if ((type(value) == HTTP.Upload) &&
              Str.starts_with?(value.tmp_path,
                HTTP.Upload.tmp_filename_prefix) &&
              File.exists?(value.tmp_path)) do
            IO.puts("HTTPd.clean_request_uploads: RM #{inspect(value.tmp_path)}")
            File.unlink(value.tmp_path)
          end
        }
        (_) { }
      })
    end
  }

  def http_client = fn (thread_id, socket, client) do
    bot? = false
    close = false
    error = true
    request = void
    Counter.increase(HTTPd.concurrent_requests, 1)
    unwind_protect(do
      HTTPd.thread_status(thread_id, "parse request")
      request = HTTP.Request.buf_parse(client.buf_rw.r)
      if request do
        HTTPd.thread_status(thread_id, "request")
        Counter.increase(HTTPd.requests, 1)
        client_addr = if client.addr_str != "127.0.0.1" do
          client.addr_str
        else
          headers = request.headers
          real_ip = headers["X-Real-IP"]
          if (real_ip) do real_ip else client.addr_str end
        end
        request = %HTTP.Request{request | client_addr: client_addr}
        user_agent = HTTP.Request.header_get(request, "User-Agent")
        response = false
        user_agent_lower = Str.to_lower(user_agent || "")
        bot? = (user_agent_lower == "") ||
               Str.has_str?(user_agent_lower, "agent") ||
               Str.has_str?(user_agent_lower, "bot") ||
               Str.has_str?(user_agent_lower, "crawler") ||
               Str.has_str?(user_agent_lower, "spider")
        if bot? do
          if Counter.increase(HTTPd.bots, 1) >= HTTPd.bots_max() do
            HTTPd.thread_status(thread_id, "bot 429")
            HTTPd.thread_request(thread_id, "--- #{client_addr} #{request.method} #{request.url} #{inspect(user_agent)} #{Time.to_str(request.time)}")
            response = error_429_page(request)
          end
        end
        if ! response do
          if (type(request.method) == Str) do
            HTTPd.thread_status(thread_id, "405")
            HTTPd.thread_request(thread_id, "--- #{client_addr} #{request.method} #{request.url} #{inspect(user_agent)} #{Time.to_str(request.time)}")
            response = error_405_page(request)
          else
            HTTPd.thread_status(thread_id, "plug")
            request = plug_request(request)
            HTTPd.thread_request(thread_id, "--- #{client_addr} #{request.method} #{request.url} #{inspect(user_agent)} #{Time.to_str(request.time)}#{request.log_msg}")
            HTTPd.thread_status(thread_id, "route_and_render_request")
            response = route_and_render_request(request)
          end
        end
        HTTPd.thread_status(thread_id, "clean_requests_uploads")
        clean_request_uploads(request.body)
        HTTPd.thread_status(thread_id, "headers")
        connection = HTTP.Request.header_get(request, "Connection") || ""
        if Compare.str_case_insensitive(connection, "close") == 0 do
          close = true
          response_headers = [{"Connection", "close"}]
        else
          response_headers = [{"Connection", "keep-alive"},
                              {"Keep-Alive", "timeout=30, max=10"}]
        end
        params = request.params
        if params[:cache_control] do
          response_headers = [{"Cache-Control", params.cache_control} |
                              response_headers]
        end
        response_headers = [{"Server", "kc3_httpd"},
                            {"Accept-Ranges", "bytes"} |
                            response_headers]
        response = HTTP.Response.headers_set(response, response_headers)
        HTTPd.thread_status(thread_id, "buf_write")
        r = HTTP.Response.buf_write(response, client.buf_rw.w,
          request.method != HEAD)
        dt = Time.now() - request.time
        dt_str = Time.diff_to_str(dt)
        HTTPd.thread_request(thread_id,
          "#{response.code} #{client_addr} #{request.method}" +
          " #{request.url} #{inspect(user_agent)}" +
          " #{dt_str}#{request.log_msg}")
        if (! close) do
          kq_ok = EventPoll.add(HTTPd.ep_fd, client.sockfd,
            HTTPd.timeout, client.ptag) == 0
        end
        error = ((r <= 0) || ((! close) && (! kq_ok)))
      end
    end, do
      HTTPd.thread_status(thread_id, "cleanup")
      Counter.decrease(HTTPd.concurrent_requests, 1)
      bots_count = if bot? do
        Counter.decrease(HTTPd.bots, 1)
      else
        Counter.get(HTTPd.bots)
      end
      if (error || close) && Socket.Buf.can_close?(client) do
        EventPoll.delete(HTTPd.ep_fd, socket, :timer)
        EventPoll.delete(HTTPd.ep_fd, socket, :read)
        Tag.delete(client.ptag)
        Socket.Buf.close(client)
        count = Counter.decrease(HTTPd.connections, 1)
        puts("HTTPd.http_client: connections=#{count} bots=#{bots_count}")
      end
    end)
  end

  def acceptor = fn (server_socket) {
    ok = false
    client = void
    client_tag = void
    incremented = false
    unwind_protect(do
      if (Counter.get(HTTPd.connections) < HTTPd.connections_max()) &&
         (client = Socket.Buf.accept(%Socket{fd: server_socket})) &&
         (client_tag = Tag.new_copy({:client, client})) &&
         Socket.Buf.set_tag(client, client_tag) &&
         Socket.timeout_set(%Socket{fd: client.sockfd},
           %Time{tv_sec: 30}) do
        Counter.increase(HTTPd.connections, 1)
        incremented = true
        count = Counter.get(HTTPd.connections)
        bots_count = Counter.get(HTTPd.bots)
        puts("HTTPd.acceptor: connections=#{count} bots=#{bots_count}")
        ok = (EventPoll.add(HTTPd.ep_fd, server_socket, void,
                HTTPd.acceptor_tag) == 0 &&
              EventPoll.add(HTTPd.ep_fd, client.sockfd, HTTPd.timeout,
                client.ptag) == 0)
      else
        EventPoll.add(HTTPd.ep_fd, server_socket, void,
          HTTPd.acceptor_tag)
      end
    end, do
      if ((! ok) && client) do
        if client_tag do
          Tag.delete(client_tag)
        end
        Socket.Buf.close(client)
        if incremented do
          Counter.decrease(HTTPd.connections, 1)
        end
      end
    end)
  }

  def daemonize = fn () {
    if KC3.daemonize do
      IO.puts("forking to background")
      if (pid = fork()) > 0 do
        exit_subprocess(0)
      end
    end
  }

  def server_thread = fn () {
    thread_id = Counter.increase(HTTPd.thread_count, 1)
    HTTPd.thread_stacktrace(thread_id, Stacktrace.ptr())
    HTTPd.thread_status(thread_id, "start")
    while ! Daemon.stopping?() do
      ignore_errors(do
        HTTPd.thread_status(thread_id, "zpoll")
        r = EventPoll.poll(HTTPd.ep_fd, %Time{tv_sec: 3600})
        match r do
          {sockfd, :eof, :acceptor} ->
            HTTPd.thread_status(thread_id, "EOF on acceptor")
            File.close(sockfd)
            Daemon.stop()
            Thread.interrupt_all()
          {sockfd, :read, :stop} ->
            HTTPd.thread_status(thread_id, "stop")
            Daemon.stop()
            Thread.interrupt_all()
          {sockfd, :read, :acceptor} ->
            HTTPd.thread_status(thread_id, "acceptor")
            HTTPd.acceptor(sockfd)
          {sockfd, :eof, {:client, client}} ->
            HTTPd.thread_status(thread_id, "eof")
            if Socket.Buf.can_close?(client) do
              EventPoll.delete(HTTPd.ep_fd, sockfd, :timer)
              EventPoll.delete(HTTPd.ep_fd, sockfd, :read)
              Tag.delete(client.ptag)
              Socket.Buf.close(client)
              count = Counter.decrease(HTTPd.connections, 1)
              bots_count = Counter.get(HTTPd.bots)
              puts("HTTPd.server_thread: eof: connections=#{count} bots=#{bots_count}")
            end
          {sockfd, :read, {:client, client}} ->
            HTTPd.thread_status(thread_id, "http_client")
            HTTPd.http_client(thread_id, sockfd, client)
          {sockfd, :timer, {:client, client}} ->
            HTTPd.thread_status(thread_id, "timeout")
            if Socket.Buf.can_close?(client) do
              EventPoll.delete(HTTPd.ep_fd, sockfd, :timer)
              EventPoll.delete(HTTPd.ep_fd, sockfd, :read)
              Tag.delete(client.ptag)
              Socket.Buf.close(client)
              count = Counter.decrease(HTTPd.connections, 1)
              bots_count = Counter.get(HTTPd.bots)
              puts("HTTPd.server_thread: timeout: connections=#{count} bots=#{bots_count}")
            end
          void ->
            HTTPd.thread_status(thread_id, "void")
            void
          x ->
            HTTPd.thread_status(thread_id, "unknown poll value")
            Err.puts("HTTPd.server_thread: unknown poll value:" +
              " #{inspect(x)}")
            void
        end
        HTTPd.thread_status(thread_id, "while")
      end)
    end
  }

  def server_thread_new = fn (x) {
    Thread.new(HTTPd.server_thread)
  }

  def server = fn (host, port) {
    unveil("./", "r")
    unveil("./db/", "crw")
    if File.exists?("./upload/") do
      unveil("./upload/", "crw")
      List.each(File.list("./upload/"), fn (name) {
        path = "./upload/#{name}"
        if File.is_directory?(path) do
          unveil(path, "crw")
        end
      })
    end
    unveil("/etc/resolv.conf", "r")
    unveil("/etc/ssl", "r")
    if Module.has_symbol?(Config, :unveil) do
      Config.unveil()
    end
    unveil("", "")
    pledge("stdio rpath wpath cpath fattr inet dns proc ps", "")
    if HTTPd.socket <- Socket.listen(host, port) do
      daemonize()
      pledge("stdio rpath wpath cpath fattr inet dns ps", "")
      IO.puts("KC3 HTTPd: listening on #{host}:#{port}")
      clean_all_uploads()
      if HTTPd.ep_fd <- EventPoll.new() do
        EventPoll.add(HTTPd.ep_fd, socket.fd, void, HTTPd.acceptor_tag)
        EventPoll.add(HTTPd.ep_fd, Daemon.stop_fd(), void,
          HTTPd.stop_tag)
        threads = List.map(List.count(HTTPd.thread_max()),
          HTTPd.server_thread_new)
        List.map(threads, Thread.delete)
        Counter.delete(HTTPd.bots)
        Counter.delete(HTTPd.concurrent_requests)
        Counter.delete(HTTPd.connections)
        Counter.delete(HTTPd.requests)
        Counter.delete(HTTPd.thread_count)
        EventPoll.delete(HTTPd.ep_fd, (S64) 0, void)
        Socket.close(HTTPd.socket)
        Tag.delete(HTTPd.acceptor_tag)
        Tag.delete(HTTPd.stop_tag)
        if Module.has_symbol?(Config, :at_exit) do
          Config.at_exit()
        end
        0
      else
        Err.puts("KC3 HTTPd: EventPoll.new")
        -1
      end
    else
      Err.puts("KC3 HTTPd: cannot listen on #{host}:#{port}")
      -1
    end
  }

  def main = fn {
    () {
      host = getenv("KC3_HTTPD_HOST")
      port = getenv("KC3_HTTPD_PORT")
      server(host, port)
    }
    (host, port) {
      server(host, port)
    }
  }

  def redirect_to = fn (url) {
    %HTTP.Response{code: 303,
                   message: "See other",
                   headers: [{"Location", URL.escape(url)}],
                   body: ""}
  }

  def error_400_page = fn (request) {
    body = """
<html>
  <head>
    <title>400 Bad Request</title>
  </head>
  <body>
    <h1>400 Bad Request</h1>
    <p>
      The request is invalid and could not be treated by the server.
    </p>
  </body>
</html>
"""
    %HTTP.Response{code: 400, body: body}
  }

  def error_404_page = fn (request) {
    body = """
<html>
  <head>
    <title>404 Not Found</title>
  </head>
  <body>
    <h1>404 Not Found</h1>
    <p>
      The requested URL #{HTML.escape(inspect(request.url))} for method #{HTML.escape(inspect(request.method))} was not found on this server.
    </p>
  </body>
</html>
"""
    %HTTP.Response{code: 404, body: body}
  }

  def error_405_page = fn (request) {
    body = """
<html>
  <head>
    <title>405 Method Not Allowed</title>
  </head>
  <body>
    <h1>405 Method Not Allowed</h1>
    <p>
      The requested method #{HTML.escape(inspect(request.method))} is not accepted on this server.
    </p>
  </body>
</html>
"""
    %HTTP.Response{code: 405, body: body}
  }

  def error_429_page = fn (request) {
    body = """
<html>
  <head>
    <title>429 Too many requests</title>
  </head>
  <body>
    <h1>429 Too many requests</h1>
    <p>
      The server has enabled rate-limiting.
    </p>
  </body>
</html>
"""
    %HTTP.Response{code: 429, body: body}
  }

  def plugs = []

  def def_plug = fn (plug) {
    tmp = List.append_one(HTTPd.plugs, plug)
    def HTTPd.plugs = tmp
  }

  def plug_request = fn {
    (request) { plug_request(request, plugs) }
    (request, []) { request }
    (request, [plug | rest]) { plug_request(plug(request), rest) }
  }

  def routes = []

  def def_route = fn (path, controller) {
    Facts.with_transaction(Facts.env_db(), do
      tmp = List.append_one(HTTPd.routes,
        %HTTPd.Route{path: path,
                     controller: controller})
      def HTTPd.routes = tmp
    end)
  }

  def route_and_render_request = fn {
    (request) {
      route_and_render_request(request, routes)
    }
    (request, route_list) {
      response = List.find_if(route_list, fn (route) {
        if (controller = HTTPd.Route.match(route, request)) do
          let(request.params, controller(request))
        end
      })
      response || error_404_page(request)
    }
  }

  def parse_range = fn {
    (false, max) {
      if max > 0 do
        {(Sw) 0, (Sw) max - 1}
      else
        {:error, "parse_range: max is too low"}
      end
    }
    (range, max) {
      if Str.starts_with?(range, "bytes=") do
        range = Str.slice(range, 6, -1)
        [start, end_] = Str.split(range, "-")
        if start do
          start = (Sw) start
          end_ = if end_ != "" do
            (Sw) end_
          else
            (Sw) max - 1
          end
          if start > end_ do
            {:error, "parse_range: start > end"}
          else
            if end_ >= max do
              {:error, "parse_range: end >= max"}
            else
              {start, end_}
            end
          end
        else
          if max >= 1 do
            {(Sw) 0, (Sw) max - 1}
          else
            {:error, "parse_range: max < 1"}
          end
        end
      else
        if max >= 1 do
          { (Sw) 0, (Sw) max - 1 }
        else
          {:error, "parse_range: max < 1"}
        end
      end
    }
  }

  HTTPd.Route.def_static_route("", "./static/", 0)

end
