defmodule Mutex do

  defstruct [mutex: (Uw) 0,
             ready: false]

  def delete = cfn Void "kc3_mutex_delete" (Mutex*)

  def lock = cfn Void "kc3_mutex_lock" (Mutex*)

  def marshall = cfn Marshall* "mutex_marshall" (Marshall*, Bool,
    Mutex*)

  def marshall_read = cfn Mutex* "mutex_marshall_read" (MarshallRead*,
    Bool, Result)

  def new = cfn Mutex* "kc3_mutex_new" (Result)

  def unlock = cfn Void "kc3_mutex_unlock" (Mutex*)

end
