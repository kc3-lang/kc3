require File
require HTML
require HTTP
require HTTP.Range
require HTTP.Response
require URL

defmodule HTTPd.Static do

  def directory = fn (prefix, root_dir, url) {
    files = List.sort(File.list(root_dir + url))
    file_li = fn (file) {
      if Str.starts_with?(file, ".") do
        ""
      else
        slash = if Str.ends_with?(url, "/") do "" else "/" end
        real_path = "#{root_dir}#{url}#{slash}#{file}"
        dir? = File.is_directory?(real_path)
        dir_slash = if dir? do "/" else "" end
        href = "#{prefix}#{url}#{slash}#{file}#{dir_slash}"
        mode = if dir? do "dr-xr-xr-x" else "-r--r--r--" end
        """<li>#{mode} <a href="#{URL.escape(href)}">#{HTML.escape(file)}</a>#{dir_slash}</li>\n"""
      end
    }
    body = """<html>
  <head>
    <title>Index of #{HTML.escape(prefix)}#{HTML.escape(url)}</title>
    <style type="text/css">
      ul { font-family: monospace; }
    </style>
  </head>
  <body>
    <h1>Index of #{HTML.escape(prefix)}#{HTML.escape(url)}</h1>
    <ul>
      #{str(List.map(files, file_li))}
    </ul>
  </body>
</html>
"""
    %HTTP.Response{body: body}
  }

  def response_full = fn (path, mime, size, last_modified) {
    headers = [{"Accept-Ranges", "bytes"},
               {"Content-Disposition", "inline"},
               {"Content-Type", (Str) mime},
               {"Content-Length", (Str) size},
               {"Last-Modified", last_modified}]
    body = if size > 0 do
      File.mmap(File.open_r(path), (Uw) 0, size)
    else
      ""
    end
    %HTTP.Response{code: (U16) 200,
                   body: body,
                   headers: headers}
  }

  def response_partial = fn (path, mime, size, last_modified, range) {
    content_length = (Uw) (range.last - range.first + 1)
    headers = [{"Accept-Ranges", "bytes"},
               {"Content-Disposition", "inline"},
               {"Content-Type", (Str) mime},
               {"Content-Length", (Str) content_length},
               {"Content-Range",
                "bytes #{range.first}-#{range.last}/#{size}"},
               {"Last-Modified", last_modified}]
    %HTTP.Response{code: (U16) 206,
                   body: File.mmap(File.open_r(path), range.first,
                                   (Uw) (range.last + 1)),
                   headers: headers}
  }

  def response_range_not_satisfiable = fn (size) {
    headers = [{"Accept-Ranges", "bytes"},
               {"Content-Range", "bytes */#{size}"},
               {"Content-Type", "text/html"}]
    %HTTP.Response{code: (U16) 416,
                   body: """<html>
  <head>
    <title>Error 416</title>
  </head>
  <body>
    <h1>Error 416 Range Not Satisfiable</h1>
  </body>
</html>""",
                   headers: headers}
  }

  def show = fn (request, root_dir, url) {
    path = root_dir + url
    if (! File.exists?(path)) do
      slash = if Str.ends_with?(path, "/") do "" else "/" end
      path = "#{path}#{slash}index.html"
    end
    if File.exists?(path) do
      mime = HTTP.mime_type(File.ext(path))
      stat = File.stat(path)
      last_modified = Str.ftime(stat.st_mtim, "%a, %d %b %G %T %Z")
      match HTTP.Range.from_request(request, stat.st_size) do
        :ignore ->
          HTTPd.Static.response_full(path, mime, stat.st_size,
                                     last_modified)
        :unsatisfiable ->
          HTTPd.Static.response_range_not_satisfiable(stat.st_size)
        range ->
          HTTPd.Static.response_partial(path, mime, stat.st_size,
                                        last_modified, range)
      end
    end
  }

  def def_route = fn (prefix, root_dir, url_skip) {
    static_route = fn (request) {
      url = URL.eat(request.url, url_skip)
      if (Str.starts_with?(url, "/") &&
         ! Str.has_str?(url, "/../") &&
         ! Str.ends_with?(url, "/..")) do
        path = root_dir + url
        if File.exists?(path) do
          if File.is_directory?(path) do
            HTTPd.Static.directory(prefix, root_dir, url)
          else
            HTTPd.Static.show(request, root_dir, url)
          end
        end
      end
    }
    HTTPd.def_route(prefix, static_route)
  }

end
