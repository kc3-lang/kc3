defmodule DNS do

  def comp = cfn Tag "dns_comp" (Str, Result)

  def dn_comp = cfn S32 "dns_dn_comp" (Char*, U8*, S32, U8**, U8**)

  def dn_expand = cfn S32 "dn_expand" (U8*, U8*, U8*, Char*, S32)

  def expand = cfn Tag "dns_expand" (Str, Uw, Result)

  def init = cfn S32 "dns_init" ()

  def mkquery = cfn Tag "dns_mkquery" (S32, Str, S32, S32, Tag, Tag,
    Result)

  def query = cfn Tag "dns_query" (Str, S32, S32, Result)

  def res_mkquery = cfn S32 "res_mkquery" (S32, Char*, S32, S32,
    U8*, S32, U8*, U8*, S32)

  def res_query = cfn S32 "res_query" (Char*, S32, S32, U8*, S32)

  def res_search = cfn S32 "res_search" (Char*, S32, S32, U8*, S32)

  def res_send = cfn S32 "dns_res_send" (U8*, S32, U8*, S32)

  def search = cfn Tag "dns_search" (Str, S32, S32, Result)

  def send = cfn Tag "dns_send" (Str, Result)

  def txt = cfn Tag "dns_txt" (Str, Result)

end
