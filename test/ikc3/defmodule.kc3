quote defmodule Empty do end
defmodule Empty do end
quote defmodule Const do
  def a = 1
  def b = 10000000000000000000000000000000000000000000000000
end
defmodule Const do
  def a = 1
  def b = 10000000000000000000000000000000000000000000000000
end
quote Const.a
Const.a
quote Const.b
Const.b
quote defmodule Double do
  def double = fn (x) { x * 2 }
end
defmodule Double do
  def double = fn (x) { x * 2 }
end
quote Double.double(21)
Double.double(21)
quote defmodule Plop do
  def a = 1
  def b = fn () { a }
end
defmodule Plop do
  def a = 1
  def b = fn () { a }
end
quote Plop.a
Plop.a
quote Plop.b
Plop.b
quote Plop.b()
Plop.b()
quote defmodule S32 do

  def cast = cfn S32 "s32_init_cast" (Result, Sym, Tag)

end
defmodule S32 do

  def cast = cfn S32 "s32_init_cast" (Result, Sym, Tag)

end
let %{a: 2} do {a, Const.a} end
let %{double: 99} do
  f = ^ Double.double
  f(21)
end
let %{double: fn (x) { x * 3 }} do
  f = ^ Double.double
  {double(21), f(21), Double.double(21)}
end
a = 2
{a, Const.a}
