require HTTPS.Client
HTTPS.Client
%{a: "b"}
%{a: "b"}
HTTPS.Client.encode_form(%{a: "b"})
"a=b"
HTTPS.Client.encode_form(%{a: "x&y"})
"a=x%26y"
HTTPS.Client.encode_form(%{a: "x=y"})
"a=x%3Dy"
